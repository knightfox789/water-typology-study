{"provenance":{"agri_mcm":{"label":"Agricultural water demand (as recommended)","formula":"crop area x recommended crop water requirement, summed over crops","source":"The study's district water balance","vintage":"2017-18 cropping, State Irrigation Plan 2016-20 norms","unit":"MCM (million cubic metres) a year","limitations":["Based on what the State Irrigation Plan recommends for each crop, not on what is actually applied in the field."]},"livestock_mcm":{"label":"Livestock water demand","formula":"livestock population x per-head daily requirement x 365","source":"The study's district water balance","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":[]},"domestic_mcm":{"label":"Domestic water demand","formula":"population x per-capita daily norm x 365","source":"The study's district water balance","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":[]},"industrial_mcm":{"label":"Industrial water demand","formula":"reported industrial withdrawal","source":"The study's district water balance","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":["No figure is recorded for Rajkot, Surendranagar, Morbi or Botad. Read a zero there as missing information, not as an absence of industry — their total demand is understated by whatever industry in fact uses."]},"supply_mcm":{"label":"Total water supply","formula":"surface water + groundwater availability","source":"The study's district water balance","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":["One figure for the whole year, with no month-by-month pattern. A district with enough water annually can still run dry in summer, and this figure will not show it."]},"ideal_demand_mcm":{"label":"Total demand (as recommended)","formula":"agriculture + livestock + domestic + industrial","source":"Sum of the four demand figures above","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":["Agriculture dominates this total in every district, so the whole figure moves with the agricultural assumption."]},"revised_agri_mcm":{"label":"Agricultural water demand (as actually used)","formula":"recommended agricultural demand x the region's actual-use factor","source":"Household survey of actual irrigation practice, compared against recommended crop water requirements","vintage":"2020-22 survey, applied to 2017-18 cropping","unit":"MCM (million cubic metres) a year","limitations":["The actual-use factor was measured for the region as a whole and applied to every district in it. This district's figure therefore reflects irrigation practice across its region, not practice measured in this district.","Across Gujarat farmers apply about 21% more water than recommended, but the regional range is wide — from 7% less in South Gujarat to 55% more in Kachchh."]},"revised_demand_mcm":{"label":"Total demand (as actually used)","formula":"actual-use agriculture + livestock + domestic + industrial","source":"Sum of the four demand figures above","vintage":"2017-18 / 2020-22","unit":"MCM (million cubic metres) a year","limitations":["Carries the regional actual-use factor, so part of this total reflects region-wide practice rather than this district's."]},"ideal_gap_mcm":{"label":"Demand-supply gap (as recommended)","formula":"total demand - total supply","source":"Computed from the figures above","vintage":"2017-18","unit":"MCM (million cubic metres) a year","limitations":["A negative figure means supply exceeds demand — a surplus."]},"ideal_gap_pct":{"label":"Gap as % of supply (as recommended)","formula":"(total demand - total supply) / total supply x 100","source":"Computed from the figures above","vintage":"2017-18","unit":"% of supply","limitations":["The gap is measured against supply, not against demand. A gap of 100% means demand is twice what is available.","A negative figure means a surplus."]},"revised_gap_mcm":{"label":"Demand-supply gap (as actually used)","formula":"actual-use demand - total supply","source":"Computed from the figures above","vintage":"2017-18 / 2020-22","unit":"MCM (million cubic metres) a year","limitations":["A negative figure means supply exceeds demand — a surplus.","Carries the regional actual-use factor, so part of this gap reflects region-wide irrigation practice rather than this district's."]},"revised_gap_pct":{"label":"Gap as % of supply (as actually used)","formula":"(actual-use demand - total supply) / total supply x 100","source":"Computed from the figures above","vintage":"2017-18 / 2020-22","unit":"% of supply","limitations":["The gap is measured against supply, not against demand. A gap of 100% means demand is twice what is available.","This is the measure the study's executive summary reports."]},"gca_ha":{"label":"Gross cropped area","formula":"total area sown, counting land sown more than once in a year once for each sowing","source":"District agricultural statistics","vintage":"2017-18","unit":"hectares","limitations":[]},"supply_per_ha":{"label":"Water available per hectare","formula":"total water supply / gross cropped area","source":"Computed from the figures above","vintage":"2017-18","unit":"MCM (million cubic metres) per hectare","limitations":["Measured against cropped land, not against population or total area. It answers how much water there is per unit of farmland, which is the question the study set out to ask.","A district that crops very little land can look water-rich on this measure while still being dry."]},"demand_per_ha_published":{"label":"Water demanded per hectare","formula":"total water demand / gross cropped area","source":"Computed from the figures above","vintage":"2017-18 / 2020-22","unit":"MCM (million cubic metres) per hectare","limitations":["Compared against a single threshold to class a district high or low demand. At the threshold the study uses, 31 of the 33 districts read high, so this measure separates districts weakly — the threshold control lets you set your own."]},"demand_per_ha_corrected":{"label":"Water demanded per hectare","formula":"total water demand / gross cropped area","source":"Computed from the figures above","vintage":"2017-18 / 2020-22","unit":"MCM (million cubic metres) per hectare","limitations":["Not a figure published in the report."]},"demand_index_published":{"label":"Demand class","formula":"high if water demanded per hectare is above the threshold, low if below","source":"Computed from the figures above","vintage":"2017-18 / 2020-22","unit":"high or low","limitations":["At the threshold the study uses, 31 of the 33 districts read high, so this classification separates districts weakly. The threshold control lets you set your own and see which districts move."]},"region_hike_factor":{"label":"Regional actual-use factor","formula":"water farmers actually apply / water recommended for the same crops","source":"Household survey of irrigation practice across the region's sample watersheds","vintage":"2020-22","unit":"ratio","limitations":["Measured for the region as a whole, then applied to every district in it.","Based on the watersheds sampled in that region, which were chosen to represent its agro-climatic conditions rather than any one district."]}},"thresholds":{"supply":{"mean":0.003768,"stdev":0.002359,"kind":"statistical, unweighted mean of 33 district ratios"},"demand":{"mean":0.003,"stdev":0.001616,"kind":"the value the study used to class demand; not the average across districts","statistical_mean":0.004945}},"demand_index_changes":["Porbandar"],"districts":{"1":{"id":1,"name":"Kachchh","region_code":"KCT","agri_mcm":2255.3,"livestock_mcm":26.8,"domestic_mcm":117.2,"industrial_mcm":141.8,"ideal_demand_mcm":2541.1,"supply_mcm":2254.5,"ideal_gap_mcm":286.6,"ideal_gap_pct":12.7,"region_hike_factor":1.5506,"revised_agri_mcm":3497.1,"revised_demand_mcm":3782.9,"revised_gap_mcm":1528.4,"revised_gap_pct":67.8,"gca_ha":809386,"supply_per_ha":0.0027854,"supply_z":-0.417,"supply_index":"Low","demand_per_